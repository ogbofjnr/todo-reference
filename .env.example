# All variables are optional. VITE_* values are inlined into the public bundle:
# never put secrets here. Schema: src/shared/config/env.ts

# Artificial delay (ms, 0–10000) added to every storage call, so loading and
# optimistic states are visible in local development. Default: 0.
VITE_SIMULATED_LATENCY_MS=0

# Probability (0–1) that a storage write fails, to exercise optimistic rollback
# by hand. Default: 0.
VITE_SIMULATED_FAILURE_RATE=0
